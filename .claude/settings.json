{
  "permissions": {
    "allow": [
      "Bash(git push origin HEAD:main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hebrew-rule.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hebrew-rule.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hebrew-guard.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 400000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_GOAL_CHECKIN_MINUTES": "0"
  },
  "promptSuggestionEnabled": false,
  "crossSessionInbound": "hold"
}
