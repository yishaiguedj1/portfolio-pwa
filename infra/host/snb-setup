#!/bin/sh
# החלפת המפתחות בשרת (מהקונסולה של Hetzner). ההקמה עצמה — "קוד ההקמה" מהאפליקציה, בלי הסקריפט הזה.
# ההודעות באנגלית: הקונסולה של לינוקס לא מציגה עברית. המפתחות לא מוצגים על המסך ולא נשמרים בשום מקום אחר:
#   /etc/snb/worker.env — בעלות root, הרשאות 600. Docker מעביר אותם לקונטיינר בלבד.
set -eu
[ "$(id -u)" = 0 ] || { echo "Run as root"; exit 1; }
umask 077
mkdir -p /etc/snb
# השאלה והמעבר לשורה — ל־stderr (המסך): הפונקציה רצה בתוך $(...), ו־stdout שלה הוא הערך בלבד.
# לקח 09/10/2026: השאלה נבלעה במשתנה — המסך נשאר ריק, והמפתח נפסל כי התחיל בטקסט השאלה.
ask_secret() {
	printf '%s\n> ' "$1" >&2
	stty -echo 2>/dev/null || true
	IFS= read -r v
	stty echo 2>/dev/null || true
	echo >&2
	printf '%s' "$v"
}
AK=$(ask_secret "Anthropic API key (starts with sk-ant-; hidden):")
case "$AK" in sk-ant-*) ;; *) echo "x Not an Anthropic key"; exit 1 ;; esac
WT=$(ask_secret "Server token (app: Studio > Settings > Server > Add server; hidden):")
printf '%s' "$WT" | grep -Eq '^[A-Za-z0-9_-]{32,128}$' || { echo "x Bad server token"; exit 1; }
printf '%s\n> ' "Heartbeat URL (e.g. healthchecks.io), optional - Enter to skip:"
IFS= read -r HB
case "$HB" in ""|https://*) ;; *) echo "x The URL must start with https://"; exit 1 ;; esac
{
	printf 'ANTHROPIC_API_KEY=%s\n' "$AK"
	printf 'SNB_WORKER_TOKEN=%s\n' "$WT"
	if [ -n "$HB" ]; then printf 'SNB_HEARTBEAT_URL=%s\n' "$HB"; fi
} >/etc/snb/worker.env.tmp
chmod 600 /etc/snb/worker.env.tmp
mv /etc/snb/worker.env.tmp /etc/snb/worker.env
echo "Saved. Starting the worker..."
systemctl start snb-update.service && /usr/local/sbin/snb-status
