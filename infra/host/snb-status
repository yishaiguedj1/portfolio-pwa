#!/bin/sh
# מצב השרת במבט אחד (לקונסולה של Hetzner).
# shellcheck source=snb-common.sh
. /usr/local/lib/snb/common.sh
echo "גרסה:   $(sed -n 's/^SNB_IMAGE=//p' "$SNB_DIR/.env" 2>/dev/null | sed 's/.*@sha256:\(............\).*/sha256:\1…/')"
echo "מפתחות: $([ -s "$SNB_ENV" ] && echo 'מוגדרים' || echo 'חסרים — snb-setup')"
echo "עבודה:  $(snb_busy && echo 'רצה עכשיו' || echo 'אין')"
snb_compose ps --format '{{.Name}}  {{.Status}}' 2>/dev/null || true
echo "דיסק:   $(df -h / | awk 'NR==2{print $3" מתוך "$2}')"
echo "--- שורות אחרונות מהעובד ---"
snb_compose logs --tail 15 worker 2>/dev/null || true
