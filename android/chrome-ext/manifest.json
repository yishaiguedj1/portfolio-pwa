{
  "manifest_version": 3,
  "name": "Studio Browser — סנכרון עם Chrome",
  "short_name": "Studio Browser",
  "description": "הסימניות וההיסטוריה של Chrome גם ב־Studio Browser בטלפון, בשני הכיוונים, בלי כפילויות.",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["bookmarks", "history", "identity", "identity.email", "storage", "alarms"],
  "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "oauth2": {
    "client_id": "286578855160-jc62oilme0m4odckdl990ek6lr8stv38.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "background": { "service_worker": "sync.js", "type": "module" },
  "action": { "default_title": "Studio Browser", "default_popup": "popup.html", "default_icon": { "32": "icon-32.png", "128": "icon-128.png" } },
  "icons": { "32": "icon-32.png", "128": "icon-128.png" }
}
