<?xml version="1.0" encoding="utf-8"?>
<!-- הטאב הנבחר — טיפת זכוכית ירוקה (‎--lg-tint ב־invest-glass.css), זהה בבהיר ובכהה -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#F046DE6E" android:endColor="#E628C052" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#CCFFFFFF" android:centerColor="#00FFFFFF" android:centerY="0.08" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
