<?xml version="1.0" encoding="utf-8"?>
<!-- זכוכית (20/11/2026): קו מתאר, גוף שקוף בהדרגה עם שפה בהירה, וברק עליון — כמו lg-body/lg-rim ב־invest-glass.css.
     לווידג'ט אין טשטוש וצל — הזכוכית מדומה בשכבות. הצבעים ב־values(-night)/widget_glass.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><corners android:radius="22dp" />
            <stroke android:width="0.5dp" android:color="@color/gl_edge" />
        </shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle"><corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="@color/gl_body_top" android:endColor="@color/gl_body_bot" />
            <stroke android:width="1dp" android:color="@color/gl_rim" />
        </shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle"><corners android:radius="22dp" />
            <gradient android:angle="270" android:type="linear" android:startColor="@color/gl_sheen" android:centerColor="#00FFFFFF" android:centerY="0.07" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
