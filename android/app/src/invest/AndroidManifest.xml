<?xml version="1.0" encoding="utf-8"?>
<!-- Invest בלבד: הכתובת הישנה והווידג'טים (מתמזג עם src/main/AndroidManifest.xml) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <!-- 2.0.0: הכתובת הישנה — קישורים ישנים (האתר שם מעביר לחדשה) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yishaiguedj1.github.io" android:pathPrefix="/portfolio-pwa" />
            </intent-filter>
        </activity>

        <!-- רשימת המניות מהאתר לווידג'ט (intent://widget?s=…#Intent;scheme=snowball;…) — בלי מסך -->
        <activity
            android:name=".WidgetSyncActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="snowball" android:host="widget" />
            </intent-filter>
        </activity>

        <receiver android:name=".TickReceiver" android:exported="false" />

        <!-- הווידג'ט למסך הבית (Glance) -->
        <receiver
            android:name=".SnowballWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/snowball_widget_info" />
        </receiver>

        <!-- v249: ווידג'ט "רשימות מעקב" — טאבים למעבר בין הרשימות -->
        <receiver
            android:name=".SnowballWatchWidgetReceiver"
            android:exported="true"
            android:label="@string/wWatchLabel">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/snowball_watch_widget_info" />
        </receiver>

    </application>
</manifest>
