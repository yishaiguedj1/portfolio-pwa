<?xml version="1.0" encoding="utf-8"?>
<!-- Studio Lab (24/10/2026, "תרגום סרטונים בטלפון" — שלב 0): כלי מדידה בלבד, לא TWA. ה־MainActivity של main
     ושירות ה־TWA יוצאים מהמניפסט (כמו ב־Studio DM). הרשת — רק להורדת המודלים (Hugging Face, ה־Release שלנו ב־GitHub). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:extractNativeLibs="true" android:largeHeap="true" tools:replace="android:theme"
        android:theme="@style/LabTheme">

        <meta-data android:name="asset_statements" tools:node="remove" />
        <activity android:name=".MainActivity" tools:node="remove" />
        <service android:name="com.google.androidbrowserhelper.trusted.DelegationService" tools:node="remove" />

        <activity
            android:name=".lab.LabActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
