<?xml version="1.0" encoding="utf-8"?>
<!-- Studio בלבד (22/10/2026): "שיתוף ← Studio" מכל אפליקציה — טקסט עם קישור לסרטון (יוטיוב, אינסטגרם, Chrome…).
     MainActivity פותח את Studio עם ‎#share=<הטקסט>, והאתר פותח את דף "מקישור" עם הבדיקה כבר רצה. בלי הרשאות.
     שלב 2: דפדפן הציד (HuntActivity). הבועה (שירות נגישות) — ב־APK נפרד, Studio Bubble (src/bubble): Play Protect חוסם
     התקנה מחוץ לחנות של אפליקציה שמבקשת שירות נגישות, ובגללה Studio כולו לא הותקן (22/10/2026). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- לחיצה ארוכה על האייקון: "דפדפן ציד" -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- דפדפן הציד (מהאתר: intent://hunt?u=…#Intent;scheme=snbstudio;…, ומקיצור הדרך באייקון) -->
        <activity
            android:name=".HuntActivity"
            android:exported="true"
            android:label="@string/huntLabel"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="snbstudio" android:host="hunt" />
            </intent-filter>
        </activity>
    </application>
</manifest>
