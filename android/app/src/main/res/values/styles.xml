<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- דריסה של הסגנון (הריק) ש־Glance שם על ה־ListView של LazyColumn (glance_list.xml): בלי פס גלילה — הגלילה עובדת -->
    <style name="Glance.AppWidget.List" parent="">
        <item name="android:scrollbars">none</item>
        <item name="android:fadeScrollbars">true</item>
    </style>
    <!-- 28/10/2026 (מעבר מקיף — "בלי קפיצות"): מסך הפתיחה של המעטפת. Theme.Material צייר רקע אפור (#303030)
         עד שהלוגו (שחור) עלה — אפור ואז שחור. עכשיו שחור מהפריים הראשון, כולל סרגלי המערכת.
         30/10/2026 (R8): הרקע בצבע הדף (splash_bg: בהיר/כהה לפי המערכת) — אותו צבע עד הציור הראשון של האתר -->
    <style name="SplashTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:colorBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
    </style>
    <!-- 08/11/2026: מסך עדכון התוכנה — בהיר/כהה לפי המערכת (splash_bg = הרקע של האתר), בלי הבהוב כהה בפתיחה; הזכוכית — בקוד (UpdActivity) -->
    <style name="UpdTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
