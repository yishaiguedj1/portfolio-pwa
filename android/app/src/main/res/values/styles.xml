<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- דריסה של הסגנון (הריק) ש־Glance שם על ה־ListView של LazyColumn (glance_list.xml): בלי פס גלילה — הגלילה עובדת -->
    <style name="Glance.AppWidget.List" parent="">
        <item name="android:scrollbars">none</item>
        <item name="android:fadeScrollbars">true</item>
    </style>
    <!-- 28/10/2026 (מעבר מקיף — "בלי קפיצות"): מסך הפתיחה של המעטפת. Theme.Material צייר רקע אפור (#303030)
         עד שהלוגו (שחור) עלה — אפור ואז שחור. עכשיו שחור מהפריים הראשון, כולל סרגלי המערכת -->
    <style name="SplashTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bar</item>
        <item name="android:colorBackground">@color/bar</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
    </style>
</resources>
