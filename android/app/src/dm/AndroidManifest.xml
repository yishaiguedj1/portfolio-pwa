<?xml version="1.0" encoding="utf-8"?>
<!-- Studio DM (23/10/2026, בקשת המשתמש): מנהל הורדות נייטיב — לא TWA. ה־MainActivity של main (פתיחת האתר בכרום)
     ושירות ה־TWA יוצאים מהמניפסט; האפליקציה = DmActivity (Compose). שום דבר לא עובר דרך השרת שלנו:
     כל הקבצים נשמרים רק בטלפון (MediaStore: Download/Movies/Music ‏→ Studio DM). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 26/10/2026 (בקשת המשתמש): התקנת APK שירד — בלי ההצהרה מתקין החבילות מסרב בלי אפשרות לאשר. ההתקנה עצמה
         תמיד באישור שלך במסך של המערכת (DmActivity.install) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 01/11/2026 (סבב 2): Wi‑Fi וסלולר יחד — לבקש גם את הרשת הסלולרית (רק כשההגדרה דלוקה; DmBondNet) -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 02/11/2026 (סבב 4, ‏36): ניגון ברקע בנגן של DM (שירות מדיה — DmPlayback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- אנדרואיד 14+: ההורדה כמשימת העברה שהמשתמש התחיל (UIDT) — בלי מגבלת 6 השעות של dataSync -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 26/10/2026: רשימת האתרים לבועה (DmSitesProvider) — רק לאפליקציות שחתומות במפתח שלנו. מוגדרת גם ב־Studio Bubble,
         כדי שההרשאה תינתן בלי קשר לסדר ההתקנה -->
    <permission android:name="app.thesnowball.permission.DM_SITES" android:protectionLevel="signature" />
    <!-- 01/11/2026: הגשר Studio Browser ↔ Studio DM (DmBridge) — רק אפליקציות שחתומות במפתח שלנו. מוגדרת בשתיהן -->
    <permission android:name="app.thesnowball.permission.DM_HANDOFF" android:protectionLevel="signature" />
    <uses-permission android:name="app.thesnowball.permission.DM_HANDOFF" />
    <!-- 01/11/2026 (סבב 3, פריט 45): אפליקציה אחרת שמוסיפה הורדות / עוצרת / שואלת מצב (DmApiActivity) — המשתמש מאשר לכל
         אפליקציה בנפרד (dangerous). בלי עוגיות ובלי כותרות מבחוץ; deep link מהדפדפן תמיד פותח את הגיליון -->
    <permission android:name="app.thesnowball.permission.DM_ADD" android:protectionLevel="dangerous"
        android:label="@string/dmPermAdd" android:description="@string/dmPermAddS" />

    <!-- AppRoute: האפליקציה השנייה (Studio ↔ Studio DM) — בלי זה אנדרואיד 11+ "מסתיר" אותה -->
    <queries>
        <package android:name="app.thesnowball.studio" />
        <package android:name="app.thesnowball.browser" />
        <!-- 01/11/2026 (סבב 3, בודק APK): "זה עדכון של אפליקציה שמותקנת — אותה חתימה?" — רואים אפליקציות עם סמל במסך
             הבית בלבד (בלי QUERY_ALL_PACKAGES) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:extractNativeLibs="true" tools:replace="android:theme"
        android:theme="@style/DmTheme">

        <meta-data android:name="asset_statements" tools:node="remove" />
        <activity android:name=".MainActivity" tools:node="remove" />
        <service android:name="com.google.androidbrowserhelper.trusted.DelegationService" tools:node="remove" />

        <!-- שלב 3: אריח "הורדה מהלוח" בהגדרות המהירות -->
        <service
            android:name=".dm.DmTile"
            android:exported="true"
            android:icon="@drawable/dm_tile"
            android:label="@string/dmTileLabel"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 01/11/2026 (סבב 3): אריח שני — לעצור / להמשיך הכל -->
        <service
            android:name=".dm.DmTileAll"
            android:exported="true"
            android:icon="@drawable/dm_tile"
            android:label="@string/dmTileAllLabel"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 01/11/2026 (סבב 3, פריט 45): הממשק לאפליקציות אחרות — רק בהרשאה DM_ADD, בלי ממשק -->
        <activity
            android:name=".dm.DmApiActivity"
            android:exported="true"
            android:permission="app.thesnowball.permission.DM_ADD"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="app.thesnowball.studiodm.ADD" />
                <action android:name="app.thesnowball.studiodm.API_PAUSE_ALL" />
                <action android:name="app.thesnowball.studiodm.API_RESUME_ALL" />
                <action android:name="app.thesnowball.studiodm.STATUS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".dm.DmSitesProvider"
            android:authorities="app.thesnowball.studiodm.sites"
            android:exported="true"
            android:permission="app.thesnowball.permission.DM_SITES" />

        <!-- 01/11/2026 (בקשת המשתמש: "שלא יהיו סתם שני דפדפנים"): אין כאן דפדפן — הגלישה ב־Studio Browser (DmBridge).
             הקוד של DmBrowser נשאר משותף: הצייד, הבדיקה והמסירה של Studio Browser -->
        <!-- 01/11/2026: הגשר בין הדפדפן ל־DM (DmBridge) — מיוצא רק בהרשאת חתימה, בלי ממשק -->
        <activity
            android:name=".dm.DmBridge"
            android:exported="true"
            android:permission="app.thesnowball.permission.DM_HANDOFF"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <activity
            android:name=".dm.DmActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "שיתוף ← Studio DM" מכל אפליקציה (קישור) -->
            <intent-filter android:label="@string/dmShareLabel">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "פתח באמצעות" — קישור לקובץ שאפליקציה אחרת מציעה להוריד -->
            <intent-filter android:label="@string/dmOpenLabel">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <!-- 01/11/2026 (סבב 3): deep link ‏studiodm://add?url=… — תמיד עם גיליון ההוספה -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="studiodm" android:host="add" />
            </intent-filter>
        </activity>

        <service
            android:name=".dm.DmJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service
            android:name=".dm.DmService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- סבב 4 (36): תמונה־בתוך־תמונה — במשימה משלו, כדי שרק הנגן יעבור לחלון הצף -->
        <activity
            android:name=".dm.DmPlayer"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="fullSensor"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.player"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode" />
        <!-- סבב 4 (36): שירות הניגון. מיוצא רק כדי שההתראה ומסך הנעילה של המערכת ישלטו בו; רק הנגן שלנו ו־SystemUI
             מקבלים את ה־session (DmPlayback.onGetSession) — אפליקציה אחרת לא רואה מה מתנגן -->
        <service
            android:name=".dm.DmPlayback"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- סבב 4 (7/38): תור הסנכרון — משימת מערכת בלי שעון מדויק -->
        <service
            android:name=".dm.DmWatchJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <!-- סבב 4 (27): ווידג'ט במסך הבית -->
        <receiver android:name=".dm.DmWidget" android:exported="false" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/dm_widget" />
        </receiver>
        <!-- סבב 4 (29): הקבצים הפרטיים (filesDir/vault) — פתיחה בנגן / באפליקציה אחרת רק בהרשאה זמנית; לא בגיבוי (allowBackup=false) -->
        <provider
            android:name=".dm.DmVaultProvider"
            android:authorities="${applicationId}.vault"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/dm_vault_paths" />
        </provider>
        <receiver android:name=".dm.DmAct" android:exported="false" />
        <receiver android:name=".dm.DmBoot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
